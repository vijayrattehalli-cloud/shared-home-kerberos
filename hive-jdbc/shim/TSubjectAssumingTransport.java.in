/*
 * JDK 24 compatibility shim for the Apache Hive JDBC driver.
 *
 * Replaces org.apache.hive.service.auth.TSubjectAssumingTransport, which in
 * Hive 3.x/4.x calls Subject.getSubject(AccessController.getContext()). Since
 * JDK 24 (JEP 486, Security Manager permanently disabled) that method always
 * throws UnsupportedOperationException, so kerberosAuthType=fromSubject fails.
 *
 * This version reads the caller's Subject with Subject.current() (JDK 18+)
 * and opens the SASL/GSSAPI transport inside Subject.callAs().
 *
 * Put the shim jar BEFORE the Hive driver on the classpath. build-shim.sh
 * fills in @THRIFT@ (shaded "org.apache.hive.org.apache.thrift" for the
 * -standalone jar, plain "org.apache.thrift" otherwise) and compiles against
 * your exact driver jar, so any API mismatch fails at build time.
 */
package org.apache.hive.service.auth;

import java.util.concurrent.CompletionException;
import javax.security.auth.Subject;
import org.apache.hadoop.hive.thrift.TFilterTransport;
import @THRIFT@.transport.TTransport;
import @THRIFT@.transport.TTransportException;

public class TSubjectAssumingTransport extends TFilterTransport {

    /** Marker checked by HiveKerberosClient24 to confirm the shim is active. */
    public static final String KRB_HPC_JDK24_SHIM = "1";

    public TSubjectAssumingTransport(TTransport wrapped) {
        super(wrapped);
    }

    @Override
    public void open() throws TTransportException {
        Subject subject = Subject.current();
        if (subject == null) {
            throw new TTransportException(
                "kerberosAuthType=fromSubject: no Subject is bound; open the connection inside Subject.callAs(...)");
        }
        try {
            Subject.callAs(subject, () -> {
                wrapped.open();
                return null;
            });
        } catch (CompletionException e) {
            Throwable c = e.getCause();
            if (c instanceof TTransportException tte) throw tte;
            if (c instanceof RuntimeException re) throw re;
            throw new TTransportException(c);
        }
    }
}
