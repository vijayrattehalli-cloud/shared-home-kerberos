#!/usr/bin/env python3
"""krb-install-ccache DEST  (self-contained; invoked via setpriv as the user).

Reads a ccache on stdin and installs it atomically at DEST (parent 0700, file
0600). Self-contained on purpose: the daemon runs this from a libexec path
far from the krbhpc package, so it imports nothing beyond the stdlib.
"""
import os, sys, tempfile


def main():
    if len(sys.argv) != 2:
        print("usage: krb-install-ccache DEST", file=sys.stderr); return 2
    dest = sys.argv[1]
    data = sys.stdin.buffer.read()
    if not data:
        print("krb-install-ccache: empty ccache on stdin", file=sys.stderr); return 1
    os.umask(0o077)
    d = os.path.dirname(dest) or "."
    os.makedirs(d, exist_ok=True)
    try:
        os.chmod(d, 0o700)
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".krb5cc.")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o600)
        os.replace(tmp, dest)
    except BaseException:
        try: os.unlink(tmp)
        except OSError: pass
        raise
    return 0


if __name__ == "__main__":
    sys.exit(main())
