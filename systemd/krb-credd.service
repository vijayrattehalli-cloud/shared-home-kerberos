[Unit]
Description=krb-credd -- Kerberos client broker (root) for HPC (shared-home, S4U client of AD)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/krb-credd -c /etc/krb-hpc/credd.conf
Restart=on-failure
RestartSec=5
User=root
UMask=0077
RuntimeDirectory=krb-hpc
StateDirectory=krb-hpc

# --- sandboxing (tuned so setpriv can drop to the user and kinit can reach AD) ---
ProtectSystem=strict
# krb-credd writes tickets into users' home dirs via the setpriv child, so the
# home root must be writable here. If homes live elsewhere (e.g. /gpfs/home),
# add that path -- otherwise every install fails with "Read-only file system".
ReadWritePaths=/var/lib/krb-hpc /run/krb-hpc /home
ProtectHome=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# NB: NOT NoNewPrivileges (setpriv re-exec needs it off); the setpriv child
# itself runs with --no-new-privs and all caps dropped.
# Least privilege. SETUID/SETGID/SETPCAP: setpriv switches to the user and
# drops capabilities. DAC_READ_SEARCH (read-only): lets the daemon notice that a
# user deleted ~/.krb5/krb5cc_hpc so the refresh puts it back. Nothing else is
# needed -- the daemon only writes to its own root-owned files, and all writes
# into homes happen as the user. (Previously also DAC_OVERRIDE, CHOWN, FOWNER.)
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_DAC_READ_SEARCH
SystemCallFilter=@system-service @setuid
SystemCallFilter=~@debug @mount @swap @reboot @obsolete @cpu-emulation
SystemCallErrorNumber=EPERM
# keytabs are the crown jewels; make them inaccessible to this unit if you
# relocate them, and keep them root:0600 (the daemon enforces this at startup).

# Validate a deployment before enabling the unit:
#   krb-credd --check [--user <name>]

[Install]
WantedBy=multi-user.target
