[Unit]
Description=Kerberos credential daemon for HPC (krb-credd, shared-home, Python)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
# Installed via `pip install .` (console script), or run the repo wrapper directly:
#   ExecStart=/opt/krb-hpc/bin/krb-credd -c /etc/krb-hpc/credd.conf
ExecStart=/usr/local/bin/krb-credd -c /etc/krb-hpc/credd.conf
Restart=on-failure
User=root
RuntimeDirectory=krb-hpc
StateDirectory=krb-hpc
UMask=0077
ProtectSystem=strict
# the setpriv child writes into home directories: list your home roots here
ReadWritePaths=/var/lib/krb-hpc /run/krb-hpc /home
PrivateTmp=true
NoNewPrivileges=false
# setpriv needs CAP_SETUID/SETGID to act as the user when writing their ccache
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER

[Install]
WantedBy=multi-user.target
